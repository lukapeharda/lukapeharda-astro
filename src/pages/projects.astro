---
import MainLayout from '../layouts/MainLayout.astro';
import ActiveProjects from '../components/ActiveProjects.jsx';

import { getCollection } from 'astro:content';

const activeProjects = await getCollection('activeProjects');
---

<MainLayout title="Side projects" description="Side projects and open source: What MTB Tire, Adaptive Favicon, Laravel packages and PHP API clients">
    <ActiveProjects projects={ activeProjects } client:idle></ActiveProjects>
</MainLayout>